    <string name="feed_seekbar">Fortschrittsleiste bei jedem Video</string>
    <string name="feed_seekbar_desc">Zeigt bei allen Videos eine Fortschrittsleiste zum Spulen. Standardmäßig an.</string>
    <string name="cl451_chat">Live-Chat-Aufnahme behoben</string>
    <string name="cl451_chat_desc">Vorher wurde nichts gespeichert. Jetzt wird der Chat zuverlässig erfasst und beim Verlassen als eine Datei pro Stream in Download/TikMod gespeichert.</string>
    <string name="notif_adding_chat">Chat wird ins Video eingefügt… %1$d%%</string>
