    <string name="cl410_lang">10 languages</string>
    <string name="cl410_lang_desc">TikMod and its card inside TikTok follow your phone\'s language: English, Hebrew, Arabic, Chinese, French, Spanish, Russian, German, Portuguese and Turkish.</string>
    <string name="cl410_record">Record now, several at once</string>
    <string name="cl410_record_desc">Start recording any live stream instantly and record several in parallel, with a live panel to stop each one.</string>
    <string name="cl410_stable">Ready for TikTok updates</string>
    <string name="cl410_stable_desc">TikMod now finds TikTok\'s hidden code by its structure, so features keep working after TikTok updates.</string>
    <string name="cl410_storage">Storage guard</string>
    <string name="cl410_storage_desc">A recording only starts with 1 GB free, and stops and saves safely before storage runs out.</string>
