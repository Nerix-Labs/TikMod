    <string name="cl410_lang">10 idiomas</string>
    <string name="cl410_lang_desc">TikMod y su tarjeta dentro de TikTok usan el idioma de tu teléfono: inglés, hebreo, árabe, chino, francés, español, ruso, alemán, portugués y turco.</string>
    <string name="cl410_record">Graba ya, varios a la vez</string>
    <string name="cl410_record_desc">Empieza a grabar cualquier transmisión en directo al instante y graba varias en paralelo, con un panel en vivo para detener cada una.</string>
    <string name="cl410_stable">Listo para las actualizaciones de TikTok</string>
    <string name="cl410_stable_desc">TikMod ahora localiza el código oculto de TikTok por su estructura, así las funciones siguen funcionando tras las actualizaciones de TikTok.</string>
    <string name="cl410_storage">Protección del almacenamiento</string>
    <string name="cl410_storage_desc">Una grabación solo empieza con 1 GB libre, y se detiene y se guarda de forma segura antes de quedarse sin espacio.</string>
    <string name="cl410_dark">Modo oscuro más claro</string>
    <string name="cl410_dark_desc">El texto se lee fácilmente en modo oscuro en todas las pantallas.</string>
    <string name="cl410_updates">Actualizaciones dentro de la app</string>
    <string name="cl410_updates_desc">Busca actualizaciones, mira qué cambió en cada versión y actualiza directamente desde TikMod.</string>
    <string name="cl400_ui">Una app totalmente nueva</string>
    <string name="cl400_ui_desc">La app de ajustes se rediseñó por completo con Material 3, animaciones y un panel de control.</string>
    <string name="cl400_autolive">Grabación automática de LIVE</string>
    <string name="cl400_autolive_desc">Sigue canales y grábalos automáticamente cuando empiecen un directo, incluso con TikTok cerrado.</string>
    <string name="cl400_deleted">Los mensajes eliminados se quedan</string>
    <string name="cl400_deleted_desc">Los mensajes que la otra persona elimina siguen visibles, marcados con una pequeña papelera.</string>
    <string name="cl400_share">Compartir inteligente</string>
    <string name="cl400_share_desc">Envía el video o las fotos reales a WhatsApp y otras apps en lugar de solo un enlace.</string>
    <string name="cl400_privacy">Privacidad del chat</string>
    <string name="cl400_privacy_desc">\"Visto\" solo después de que respondas, además de ocultar el estado de escritura y de conexión.</string>
    <string name="cl400_feed">Feed limpio</string>
    <string name="cl400_feed_desc">Bloquea anuncios y puede ocultar publicaciones LIVE, de compras y de fotos en el feed.</string>
    <string name="action_close">Cerrar</string>
