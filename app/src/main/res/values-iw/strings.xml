    <string name="cl410_lang">10 שפות</string>
    <string name="cl410_lang_desc">TikMod והכרטיס שלו בתוך טיקטוק מוצגים בשפת הטלפון: עברית, אנגלית, ערבית, סינית, צרפתית, ספרדית, רוסית, גרמנית, פורטוגזית וטורקית.</string>
    <string name="cl410_record">הקלטה מיידית, כמה במקביל</string>
    <string name="cl410_record_desc">מתחילים להקליט כל שידור חי מיד, ואפשר להקליט כמה שידורים במקביל עם פאנל חי לעצירת כל אחד.</string>
    <string name="cl410_stable">מוכן לעדכוני טיקטוק</string>
    <string name="cl410_stable_desc">TikMod מוצא עכשיו את הקוד המוסתר של טיקטוק לפי המבנה שלו, כך שהפיצ\'רים ממשיכים לעבוד גם אחרי עדכון של טיקטוק.</string>
    <string name="cl410_storage">הגנה על האחסון</string>
    <string name="cl410_storage_desc">הקלטה מתחילה רק כשיש 1GB פנוי, ונעצרת ונשמרת בבטחה לפני שהמקום נגמר.</string>
    <string name="cl410_dark">מצב לילה ברור יותר</string>
    <string name="cl410_dark_desc">הטקסט קריא במצב לילה בכל המסכים.</string>
    <string name="cl410_updates">עדכונים מתוך האפליקציה</string>
    <string name="cl410_updates_desc">בודקים עדכונים, רואים מה השתנה בכל גרסה ומעדכנים ישירות מ-TikMod.</string>
    <string name="cl400_ui">אפליקציה חדשה לגמרי</string>
    <string name="cl400_ui_desc">אפליקציית ההגדרות נבנתה מחדש עם Material 3, אנימציות ולוח בקרה.</string>
    <string name="cl400_autolive">הקלטת לייב אוטומטית</string>
    <string name="cl400_autolive_desc">עוקבים אחרי ערוצים, והם מוקלטים אוטומטית כשהם עולים לשידור, גם כשטיקטוק סגור.</string>
    <string name="cl400_deleted">הודעות שנמחקו נשארות</string>
    <string name="cl400_deleted_desc">הודעות שהצד השני מחק נשארות גלויות, עם סימן פח קטן.</string>
    <string name="cl400_share">שיתוף חכם</string>
    <string name="cl400_share_desc">שולחים לוואטסאפ ולאפליקציות אחרות את הסרטון או התמונות עצמם, במקום רק קישור.</string>
    <string name="cl400_privacy">פרטיות בצ\'אט</string>
    <string name="cl400_privacy_desc">\"נצפה\" רק אחרי שעונים, והסתרה של \"מקליד/ה\" ו\"פעיל/ה עכשיו\".</string>
    <string name="cl400_feed">פיד נקי</string>
    <string name="cl400_feed_desc">חוסם פרסומות, ואפשר להסתיר שידורים, סרטוני קניות ופוסטי תמונות בפיד.</string>
