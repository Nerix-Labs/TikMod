    <string name="cl410_lang">10 dil</string>
    <string name="cl410_lang_desc">TikMod ve TikTok içindeki kartı telefonunuzun dilini kullanır: İngilizce, İbranice, Arapça, Çince, Fransızca, İspanyolca, Rusça, Almanca, Portekizce ve Türkçe.</string>
    <string name="cl410_record">Hemen kaydet, aynı anda birden fazla</string>
    <string name="cl410_record_desc">Herhangi bir canlı yayını anında kaydetmeye başlayın ve birkaçını paralel kaydedin; her birini durdurmak için canlı bir panel de var.</string>
    <string name="cl410_stable">TikTok güncellemelerine hazır</string>
    <string name="cl410_stable_desc">TikMod artık TikTok\'un gizli kodunu yapısından buluyor, böylece özellikler TikTok güncellemelerinden sonra da çalışmaya devam ediyor.</string>
    <string name="cl410_storage">Depolama koruması</string>
    <string name="cl410_storage_desc">Kayıt yalnızca 1 GB boş alan varken başlar ve depolama dolmadan önce güvenle durdurulup kaydedilir.</string>
    <string name="cl410_dark">Daha net karanlık mod</string>
    <string name="cl410_dark_desc">Karanlık modda metinler her ekranda kolayca okunur.</string>
    <string name="cl410_updates">Uygulama içi güncellemeler</string>
    <string name="cl410_updates_desc">Güncellemeleri denetleyin, her sürümde nelerin değiştiğini görün ve doğrudan TikMod\'dan güncelleyin.</string>
    <string name="cl400_ui">Yepyeni bir uygulama</string>
    <string name="cl400_ui_desc">Ayarlar uygulaması Material 3, animasyonlar ve bir kontrol paneliyle yeniden yapıldı.</string>
    <string name="cl400_autolive">Otomatik LIVE kaydı</string>
    <string name="cl400_autolive_desc">Kanalları takip edin; yayına başladıklarında TikTok kapalıyken bile otomatik olarak kaydedilsinler.</string>
    <string name="cl400_deleted">Silinen mesajlar kalır</string>
    <string name="cl400_deleted_desc">Karşı tarafın sildiği mesajlar küçük bir çöp kutusu işaretiyle görünür kalır.</string>
    <string name="cl400_share">Akıllı paylaşım</string>
    <string name="cl400_share_desc">Yalnızca bağlantı yerine videonun ya da fotoğrafların kendisini WhatsApp\'a ve diğer uygulamalara gönderin.</string>
    <string name="cl400_privacy">Sohbet gizliliği</string>
    <string name="cl400_privacy_desc">\"Görüldü\" yalnızca yanıt verdikten sonra; ayrıca \"Yazıyor…\" ve çevrimiçi durumu gizlenir.</string>
    <string name="cl400_feed">Temiz akış</string>
    <string name="cl400_feed_desc">Reklamları engeller; akıştaki LIVE, alışveriş ve fotoğraf gönderilerini gizleyebilir.</string>
