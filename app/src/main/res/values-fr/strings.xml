    <string name="cl410_lang">10 langues</string>
    <string name="cl410_lang_desc">TikMod et sa carte dans TikTok suivent la langue de votre téléphone : anglais, hébreu, arabe, chinois, français, espagnol, russe, allemand, portugais et turc.</string>
    <string name="cl410_record">Enregistrez maintenant, plusieurs à la fois</string>
    <string name="cl410_record_desc">Lancez instantanément l\'enregistrement de n\'importe quel live et enregistrez-en plusieurs en parallèle, avec un panneau en direct pour arrêter chacun d\'eux.</string>
    <string name="cl410_stable">Prêt pour les mises à jour de TikTok</string>
    <string name="cl410_stable_desc">TikMod repère désormais le code caché de TikTok grâce à sa structure : les fonctions continuent de marcher après les mises à jour de TikTok.</string>
    <string name="cl410_storage">Protection du stockage</string>
    <string name="cl410_storage_desc">Un enregistrement ne démarre qu\'avec 1 GB libre, et s\'arrête puis s\'enregistre en toute sécurité avant que le stockage soit plein.</string>
    <string name="cl410_dark">Mode sombre plus lisible</string>
    <string name="cl410_dark_desc">Le texte se lit facilement en mode sombre, sur tous les écrans.</string>
    <string name="cl410_updates">Mises à jour dans l\'appli</string>
    <string name="cl410_updates_desc">Recherchez des mises à jour, consultez les changements de chaque version et mettez à jour directement depuis TikMod.</string>
    <string name="cl400_ui">Une toute nouvelle appli</string>
    <string name="cl400_ui_desc">L\'appli de réglages a été entièrement repensée avec Material 3, des animations et un tableau de bord.</string>
    <string name="cl400_autolive">Enregistrement auto des LIVE</string>
    <string name="cl400_autolive_desc">Suivez des chaînes et enregistrez-les automatiquement quand elles passent en live, même TikTok fermé.</string>
    <string name="cl400_deleted">Les messages supprimés restent</string>
    <string name="cl400_deleted_desc">Les messages supprimés par votre interlocuteur restent visibles, marqués d\'une petite corbeille.</string>
    <string name="cl400_share">Partage intelligent</string>
    <string name="cl400_share_desc">Envoyez la vraie vidéo ou les photos à WhatsApp et à d\'autres applis, pas seulement un lien.</string>
    <string name="cl400_privacy">Confidentialité des discussions</string>
    <string name="cl400_privacy_desc">« Vu » seulement après votre réponse, et statut de saisie et de connexion masqués.</string>
    <string name="cl400_feed">Fil épuré</string>
    <string name="cl400_feed_desc">Bloque les pubs et peut masquer les LIVE, les achats et les publications photo dans le fil.</string>
