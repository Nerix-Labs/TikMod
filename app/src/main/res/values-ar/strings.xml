    <string name="cl410_lang">10 لغات</string>
    <string name="cl410_lang_desc">يتبع TikMod وبطاقته داخل TikTok لغة هاتفك: الإنجليزية والعبرية والعربية والصينية والفرنسية والإسبانية والروسية والألمانية والبرتغالية والتركية.</string>
    <string name="cl410_record">سجّل الآن، وأكثر من بث معًا</string>
    <string name="cl410_record_desc">ابدأ تسجيل أي بث مباشر فورًا وسجّل عدة بثوث في الوقت نفسه، مع لوحة مباشرة لإيقاف كلٍّ منها.</string>
    <string name="cl410_stable">جاهز لتحديثات TikTok</string>
    <string name="cl410_stable_desc">أصبح TikMod يعثر على شيفرة TikTok المخفية من خلال بنيتها، فتستمر الميزات في العمل بعد تحديثات TikTok.</string>
    <string name="cl410_storage">حماية مساحة التخزين</string>
    <string name="cl410_storage_desc">لا يبدأ التسجيل إلا عند توفّر 1 GB من المساحة، ويتوقف ويُحفَظ بأمان قبل نفاد المساحة.</string>
    <string name="cl410_dark">وضع داكن أوضح</string>
    <string name="cl410_dark_desc">النص سهل القراءة في الوضع الداكن على كل الشاشات.</string>
    <string name="cl410_updates">التحديثات داخل التطبيق</string>
    <string name="cl410_updates_desc">تحقّق من وجود تحديثات، واطّلع على ما تغيّر في كل إصدار، وحدّث مباشرةً من TikMod.</string>
    <string name="cl400_ui">تطبيق جديد كليًا</string>
    <string name="cl400_ui_desc">أُعيد بناء تطبيق الإعدادات باستخدام Material 3 مع رسوم متحركة ولوحة معلومات.</string>
    <string name="cl400_autolive">تسجيل LIVE تلقائي</string>
    <string name="cl400_autolive_desc">تابع القنوات وسجّلها تلقائيًا عند بدء البث المباشر، حتى مع إغلاق TikTok.</string>
    <string name="cl400_deleted">الرسائل المحذوفة تبقى</string>
    <string name="cl400_deleted_desc">تبقى الرسائل التي يحذفها الطرف الآخر ظاهرة، مع علامة سلة مهملات صغيرة.</string>
    <string name="cl400_share">المشاركة الذكية</string>
    <string name="cl400_share_desc">أرسل الفيديو أو الصور نفسها إلى WhatsApp وتطبيقات أخرى بدلًا من مجرد رابط.</string>
    <string name="cl400_privacy">خصوصية الدردشة</string>
    <string name="cl400_privacy_desc">لا تظهر \"تمت المشاهدة\" إلا بعد أن ترد، مع إخفاء حالة الكتابة والاتصال.</string>
    <string name="cl400_feed">خلاصة نظيفة</string>
    <string name="cl400_feed_desc">يحظر الإعلانات ويمكنه إخفاء منشورات LIVE والتسوق والصور في الخلاصة.</string>
